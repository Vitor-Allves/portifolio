{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "redirects": [
    { "source": "/analise", "destination": "/intelligence", "permanent": true },
    { "source": "/analise/:path*", "destination": "/intelligence/:path*", "permanent": true }
  ]
}
