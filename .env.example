# Copy to .env.local for local development. In production, set these as
# environment variables in the Vercel project settings (Production AND
# Preview environments — the dashboard is protected in both).
#
# Full setup guide: docs/meta-ads-setup.md

# Meta Marketing API — System User access token with ads_read on every ad
# account the dashboard should read, and the Business Manager ID it belongs to.
META_SYSTEM_USER_TOKEN=
META_BUSINESS_ID=

# Optional: a second (or third, fourth, ...) completely separate Business
# Manager, merged into the same dashboard with no distinction from the
# first — e.g. a different company's own Meta account, not just another
# client shared into the business above. Each one needs its own System User
# token, since a token only ever has access to the Business Manager it was
# created in. Numbering must be contiguous starting at 2 (no gaps).
# See "Conectando um segundo Business Manager" in docs/meta-ads-setup.md.
# META_SYSTEM_USER_TOKEN_2=
# META_BUSINESS_ID_2=

# Shared password that gates /analise. Pick something long and unique — it's
# the only thing standing between this page and anyone who finds the URL.
ANALYTICS_DASHBOARD_PASSWORD=

# Random secret used to sign the login session cookie. Generate one with:
#   openssl rand -base64 32
ANALYTICS_SESSION_SECRET=

# Postgres connection string for per-client login credentials (the "Clientes"
# admin panel at /analise/admin). Set automatically when you connect a
# database to this project (Vercel → Storage → Connect Database, e.g. Neon) —
# see docs/client-access-setup.md. Optional: without it, /analise/admin shows
# a setup message instead of erroring, and only the shared admin password
# above works.
DATABASE_URL=
