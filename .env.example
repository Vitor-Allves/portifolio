# Copy to .env.local for local development. In production, set these as
# environment variables in the Vercel project settings (Production AND
# Preview environments — the dashboard is protected in both).
#
# Full setup guide: docs/meta-ads-setup.md

# Meta Marketing API — System User access token with ads_read on every ad
# account the dashboard should read, and the Business Manager ID it belongs to.
META_SYSTEM_USER_TOKEN=
META_BUSINESS_ID=

# Shared password that gates /analise. Pick something long and unique — it's
# the only thing standing between this page and anyone who finds the URL.
ANALYTICS_DASHBOARD_PASSWORD=

# Random secret used to sign the login session cookie. Generate one with:
#   openssl rand -base64 32
ANALYTICS_SESSION_SECRET=
